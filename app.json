{
  "expo": {
    "name": "Pick D",
    "slug": "pickdi",
    "version": "1.0.0",
    "scheme": "pickdi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pickdi.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FF6B9D"
      },
      "package": "com.pickdi.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "피부·얼굴 분석, 성분 분석, 리뷰·게시글·프로필 사진을 올리기 위해 사진 보관함에 접근해요.",
          "cameraPermission": "피부·얼굴 분석과 화장품 성분표 촬영을 위해 카메라를 사용해요.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "피부·얼굴 분석과 화장품 성분표 촬영을 위해 카메라를 사용해요.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "내 주변 시술 병원을 지도에 보여주기 위해 현재 위치를 사용해요.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "내 주변 병원 지도를 정확히 보여주기 위해 기기 움직임 정보를 사용할 수 있어요."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF6B9D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
