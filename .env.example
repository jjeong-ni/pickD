# 이 파일을 .env 로 복사해서 값을 채운다. (.env 는 gitignore 대상 — 커밋하지 않는다)
# EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 그대로 들어간다. 공개돼도 되는 값만 여기에 둔다.

# Supabase — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 토스페이먼츠 **클라이언트** 키 (test_ck_...). 시크릿 키는 절대 여기 넣지 않는다.
EXPO_PUBLIC_TOSS_CLIENT_KEY=

# 카카오맵 JavaScript 키 (홈·병원 지도)
EXPO_PUBLIC_KAKAO_JS_KEY=

# ── Edge Function 전용 (앱 .env 가 아니라 `npx supabase secrets set` 으로 넣는다) ──
# SUPABASE_SERVICE_ROLE_KEY, TOSS_SECRET_KEY, ANTHROPIC_API_KEY,
# GOOGLE_VISION_API_KEY, AGENT_SECRET, GITHUB_TOKEN
